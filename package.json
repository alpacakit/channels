{
  "name": "@alpacakit/channels",
  "version": "0.2.0-beta.4",
  "description": "Neutral multi-channel entry definitions with CLI, MCP, and HTTP binding adapters.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format",
    "format:write": "biome format --write",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpacakit/channels.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
